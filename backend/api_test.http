@BASE  = http://localhost:8000
@TOKEN = GANTI_DENGAN_TOKEN_HASIL_LOGIN

# ================================================================
# Cek server hidup
# ================================================================

### Root server running?
GET {{BASE}}/

### Swagger docs tersedia?
GET {{BASE}}/docs

# ================================================================
# BLOK 1 AUTH
# Expected: { "access_token": "...", "token_type": "bearer" }
# ================================================================

### Login admin dengan COPY access_token ke variabel @TOKEN di atas
# @name loginRequest
POST {{BASE}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "admin123"
}

### Cek siapa yang login (butuh token)
GET {{BASE}}/api/auth/me
Authorization: Bearer {{TOKEN}}

### Ganti password 
POST {{BASE}}/api/auth/change-password
Content-Type: application/json
Authorization: Bearer {{TOKEN}}

{
  "password_lama": "admin123",
  "password_baru": "passwordBaruKamu"
}

# ================================================================
# BLOK 2 PARKIR: GET (baca data)
# ================================================================

### GET semua parkir dengan GeoJSON FeatureCollection
# Expected: { "type": "FeatureCollection", "features": [...20 items] }
GET {{BASE}}/api/parkir

### GET parkir id=1 (Parkir Pasar Atas)
# Expected: { "id": 1, "nama": "Parkir Pasar Atas...", "latitude": ..., "fasilitas": [...] }
GET {{BASE}}/api/parkir/1

### GET parkir id=999 → harusnya 404
# Expected: { "detail": "Parkir id=999 tidak ditemukan" }
GET {{BASE}}/api/parkir/999

# ================================================================
# BLOK 3 PARKIR: SPATIAL QUERIES
# ================================================================

### 5 parkir terdekat dari Jam Gadang
# Expected: features diurutkan by jarak_meter ASC
GET {{BASE}}/api/parkir/terdekat?lat=-0.3051&lng=100.3696&limit=5

### Parkir terdekat, filter hanya MOBIL
GET {{BASE}}/api/parkir/terdekat?lat=-0.3051&lng=100.3696&limit=5&jenis=mobil

### Parkir terdekat, filter hanya MOTOR
GET {{BASE}}/api/parkir/terdekat?lat=-0.3051&lng=100.3696&limit=5&jenis=motor

### Parkir dalam radius 500m dari Jam Gadang
# Expected: { "metadata": { "radius_meter": 500, "jumlah_hasil": N }, "features": [...] }
GET {{BASE}}/api/parkir/dalam-radius?lat=-0.3051&lng=100.3696&radius=500

### Parkir dalam radius 1000m (lebih banyak hasil)
GET {{BASE}}/api/parkir/dalam-radius?lat=-0.3051&lng=100.3696&radius=1000

### Filter: hanya motor
GET {{BASE}}/api/parkir/filter?jenis=motor

### Filter: tarif max Rp 2000
GET {{BASE}}/api/parkir/filter?tarif_max=2000

### Filter: umum + tarif 2000–3000 + kapasitas min 80
GET {{BASE}}/api/parkir/filter?jenis=umum&tarif_min=2000&tarif_max=3000&kapasitas_min=80

# ================================================================
# BLOK 4 PARKIR: CRUD (butuh token admin)
# ================================================================

### POST tambah parkir baru
# Expected: { "message": "Parkir berhasil ditambahkan", "id": 21 }
POST {{BASE}}/api/parkir
Content-Type: application/json
Authorization: Bearer {{TOKEN}}

{
  "nama": "Parkir Test Step 4",
  "alamat": "Jl. Testing No. 4, Guguk Panjang",
  "jenis_kendaraan": "umum",
  "kapasitas": 45,
  "tarif_per_jam": 2000,
  "jam_buka": "07:00:00",
  "jam_tutup": "21:00:00",
  "latitude": -0.3055,
  "longitude": 100.3705,
  "kecamatan_id": 1,
  "fasilitas": [
    { "nama_fasilitas": "CCTV", "status_aktif": true },
    { "nama_fasilitas": "Toilet umum", "status_aktif": true }
  ]
}

### POST tanpa token → harusnya 401 Unauthorized
POST {{BASE}}/api/parkir
Content-Type: application/json

{
  "nama": "Harusnya Gagal",
  "jenis_kendaraan": "umum",
  "latitude": -0.3055,
  "longitude": 100.3705
}

### POST validasi gagal (jenis_kendaraan salah) → harusnya 422
POST {{BASE}}/api/parkir
Content-Type: application/json
Authorization: Bearer {{TOKEN}}

{
  "nama": "Test Validasi",
  "jenis_kendaraan": "SALAH",
  "latitude": -0.3055,
  "longitude": 100.3705
}

### PUT update parkir id=21 (yang baru dibuat)
# Expected: { "message": "Parkir berhasil diupdate", "id": 21 }
PUT {{BASE}}/api/parkir/21
Content-Type: application/json
Authorization: Bearer {{TOKEN}}

{
  "nama": "Parkir Test Step 4 (Updated)",
  "kapasitas": 60,
  "tarif_per_jam": 3000
}

### GET parkir id=21 untuk cek update berhasil
GET {{BASE}}/api/parkir/21

### DELETE parkir id=21
# Expected: { "message": "Parkir 'Parkir Test Step 4 (Updated)' berhasil dihapus" }
DELETE {{BASE}}/api/parkir/21
Authorization: Bearer {{TOKEN}}

### GET parkir id=21 setelah delete → harusnya 404
GET {{BASE}}/api/parkir/21

# ================================================================
# BLOK 5 WILAYAH
# ================================================================

### GET semua kecamatan dengan GeoJSON Polygon
# Expected: 3 features (Guguk Panjang, Mandiangin, Aur Birugo)
GET {{BASE}}/api/wilayah

### GET detail kecamatan Guguk Panjang (id=1)
GET {{BASE}}/api/wilayah/1

### GET parkir dalam kecamatan Guguk Panjang (ST_Within / fallback)
# Expected: 9 parkir
GET {{BASE}}/api/wilayah/1/parkir

### GET parkir kecamatan Mandiangin (id=2)
# Expected: 6 parkir
GET {{BASE}}/api/wilayah/2/parkir

### GET statistik ringkasan semua kecamatan
# Expected: array 3 item dengan jumlah_parkir, total_kapasitas, per_jenis
GET {{BASE}}/api/wilayah/statistik/ringkasan

### GET kecamatan id=999 harusnya 404
GET {{BASE}}/api/wilayah/999
